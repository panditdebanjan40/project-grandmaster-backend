# Copy to .env for local use (Replit: put these in the "Secrets" panel instead; Render: Environment tab).
# NEVER commit the real .env, and never put any of these values in the frontend.

# ---------------- REQUIRED ----------------
# AssemblyAI API key (https://www.assemblyai.com/ -> Dashboard -> API key)
ASSEMBLYAI_API_KEY=

# One or more access tokens, comma separated. Each must be 16+ characters.
# The frontend sends one of these as "Authorization: Bearer <token>".
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACCESS_TOKENS=

# ---------------- REQUIRED IN PRODUCTION ----------------
# Browser origins allowed to call the API (your Netlify site). Comma separated, no trailing slash.
# Example: https://my-grandmaster.netlify.app
ALLOWED_ORIGINS=

# ---------------- OPTIONAL ----------------
# NODE_ENV=production            # set on Render. In production ALLOWED_ORIGINS is mandatory.
# PORT=3000                      # Render/Replit usually provide this automatically.
# LOG_LEVEL=info                 # debug | info | warn | error

# Speech-to-text provider: assemblyai (default) or deepgram
# STT_PROVIDER=assemblyai
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# DEEPGRAM_API_KEY=              # only if STT_PROVIDER=deepgram
# DEEPGRAM_MODEL=nova-3
# STT_POLL_INTERVAL_MS=3000
# STT_TIMEOUT_SEC=600

# Limits
# MAX_AUDIO_SECONDS=600          # 10 minutes
# MAX_UPLOAD_MB=100
# MAX_CONCURRENT_JOBS=1          # free tier = 0.1 CPU; keep at 1
# MAX_QUEUED_JOBS=5
# JOB_TTL_MIN=60                 # finished jobs are deleted from memory after this long

# Rate limiting
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX=60              # requests per window per IP (polling every 2-3 s uses ~20-30)
# JOB_CREATE_LIMIT_PER_HOUR=20   # uploads per access token per hour (each one costs STT credit)
# TRUST_PROXY_HOPS=1             # number of reverse proxies in front (Render = 1)

# Audio tooling (only if ffmpeg is not found automatically)
# FFMPEG_PATH=/usr/bin/ffmpeg
# TMP_DIR=/tmp/grandmaster
